# Local Edge Functions only. Copy to supabase/functions/.env and fill secrets there.
# GEMINI_MODEL intentionally remains blank; choose currently supported model names in Google AI Studio.
# You can list several models separated by commas: the processor falls back to the next one on HTTP 429/503.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional fallbacks if the primary model is saturated. Empty means built-in defaults.
GEMINI_FALLBACK_MODELS=
# Optional: LOW by default. MINIMAL is not supported by gemini-3.8-flash.
GEMINI_THINKING_LEVEL=LOW

# WhatsApp Cloud API. Configure only after the business number is connected.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
