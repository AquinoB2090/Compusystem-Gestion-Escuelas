# Local Edge Functions only. Copy to supabase/functions/.env and fill secrets there.
# GEMINI_MODEL intentionally remains blank; choose a currently supported model in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=

# WhatsApp Cloud API. Configure only after the business number is connected.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
